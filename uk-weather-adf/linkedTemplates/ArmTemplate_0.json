		{
			"name": "[concat(parameters('factoryName'), '/pl_databricks_weather_dev')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "get_sp_client_id",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "GET",
							"headers": {},
							"url": "https://uk-weather-kv.vault.azure.net/secrets/sp-client-id?api-version=7.0",
							"authentication": {
								"type": "MSI",
								"resource": "https://vault.azure.net"
							}
						}
					},
					{
						"name": "get_sp_client_secret",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "GET",
							"headers": {},
							"url": "https://uk-weather-kv.vault.azure.net/secrets/sp-client-secret?api-version=7.0",
							"authentication": {
								"type": "MSI",
								"resource": "https://vault.azure.net"
							}
						}
					},
					{
						"name": "get_oauth_token",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "get_sp_client_id",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "get_sp_client_secret",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {
								"Content-Type": "application/x-www-form-urlencoded"
							},
							"url": "https://login.microsoftonline.com/60e31c1d-fc60-4780-a4c9-9fd7e64047c9/oauth2/v2.0/token",
							"body": {
								"value": "@concat('client_id=', activity('get_sp_client_id').output.value, '&client_secret=', activity('get_sp_client_secret').output.value, '&scope=2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default&grant_type=client_credentials')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "set_oauth_token",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "get_oauth_token",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "oauth_token",
							"value": {
								"value": "@activity('get_oauth_token').output.access_token",
								"type": "Expression"
							}
						}
					},
					{
						"name": "trigger_databricks_job",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "set_oauth_token",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {
								"Authorization": {
									"value": "@concat('Bearer ', variables('oauth_token'))",
									"type": "Expression"
								},
								"Content-Type": "application/json"
							},
							"url": "https://adb-7405615056815200.0.azuredatabricks.net/api/2.1/jobs/run-now",
							"body": "{\"job_id\": 116867814227194}"
						}
					},
					{
						"name": "set_run_id",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "trigger_databricks_job",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "run_id",
							"value": {
								"value": "@{activity('trigger_databricks_job').output.run_id}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "debug_run_id",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "set_run_id",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "GET",
							"headers": {
								"Authorization": {
									"value": "@concat('Bearer ', variables('oauth_token'))",
									"type": "Expression"
								}
							},
							"url": {
								"value": "@concat('https://adb-7405615056815200.0.azuredatabricks.net/api/2.1/runs/get?run_id=', variables('run_id'))",
								"type": "Expression"
							}
						}
					},
					{
						"name": "wait_for_completion",
						"type": "Until",
						"dependsOn": [
							{
								"activity": "debug_run_id",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@or(or(equals(activity('check_job_status').output.state.life_cycle_state, 'TERMINATED'), equals(activity('check_job_status').output.state.life_cycle_state, 'SKIPPED')), equals(activity('check_job_status').output.state.life_cycle_state, 'INTERNAL_ERROR'))",
								"type": "Expression"
							},
							"activities": [
								{
									"name": "wait_30_seconds",
									"type": "Wait",
									"dependsOn": [],
									"userProperties": [],
									"typeProperties": {
										"waitTimeInSeconds": 30
									}
								},
								{
									"name": "check_job_status",
									"type": "WebActivity",
									"dependsOn": [
										{
											"activity": "wait_30_seconds",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"method": "GET",
										"headers": {
											"Authorization": {
												"value": "@concat('Bearer ', variables('oauth_token'))",
												"type": "Expression"
											}
										},
										"url": {
											"value": "@concat('https://adb-7405615056815200.0.azuredatabricks.net/api/2.1/runs/get?run_id=', variables('run_id'))",
											"type": "Expression"
										}
									}
								}
							],
							"timeout": "0.01:00:00"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"environment": {
						"type": "string",
						"defaultValue": "dev"
					}
				},
				"variables": {
					"oauth_token": {
						"type": "String"
					},
					"run_id": {
						"type": "String"
					}
				},
				"annotations": []
			},
			"dependsOn": []
		},
