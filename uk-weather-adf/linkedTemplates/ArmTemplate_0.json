			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "uk-weather-adf"
		},
		"ls_keyvault_dev_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://uk-weather-kv.vault.azure.net/"
		},
		"ls_openweathermap_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://api.openweathermap.org"
		},
		"ls_ukweather_adls_dev_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://ukweatherstorage.dfs.core.windows.net/"
		},
		"tr_20min_weather_dev_properties_pl_weather_master_dev_parameters_environment": {
			"type": "string",
			"defaultValue": "dev"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
