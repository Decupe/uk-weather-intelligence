{
	"name": "pl_databricks_weather_dev",
	"properties": {
		"activities": [
			{
				"name": "get_sp_client_id",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://uk-weather-kv.vault.azure.net/secrets/sp-client-id?api-version=7.0",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "get_sp_client_secret",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"url": "https://uk-weather-kv.vault.azure.net/secrets/sp-client-secret?api-version=7.0",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "get_oauth_token",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "get_sp_client_id",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "get_sp_client_secret",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/x-www-form-urlencoded"
					},
					"url": "https://login.microsoftonline.com/60e31c1d-fc60-4780-a4c9-9fd7e64047c9/oauth2/v2.0/token",
					"body": {
						"value": "@concat('client_id=', activity('get_sp_client_id').output.value, '&client_secret=', activity('get_sp_client_secret').output.value, '&scope=2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default&grant_type=client_credentials')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "set_oauth_token",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "get_oauth_token",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "oauth_token",
					"value": {
						"value": "@activity('get_oauth_token').output.access_token",
						"type": "Expression"
					}
				}
			},
			{
				"name": "trigger_databricks_job",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "set_oauth_token",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Authorization": {
							"value": "@concat('Bearer ', variables('oauth_token'))",
							"type": "Expression"
						},
						"Content-Type": "application/json"
					},
					"url": "https://adb-7405615056815200.0.azuredatabricks.net/api/2.1/jobs/run-now",
					"body": "{\"job_id\": 116867814227194}"
				}
			}
		],
		"parameters": {
			"environment": {
				"type": "string",
				"defaultValue": "dev"
			}
		},
		"variables": {
			"oauth_token": {
				"type": "String"
			}
		},
		"annotations": []
	}
}