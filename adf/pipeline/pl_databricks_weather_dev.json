{
	"name": "pl_databricks_weather_dev",
	"properties": {
		"activities": [
			{
				"name": "run_silver_orchestrator",
				"type": "DatabricksNotebook",
				"dependsOn": [],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Workspace/weather_notebook/nb_silver_orchestrator_dev",
					"baseParameters": {
						"environment": {
							"value": "@pipeline().parameters.environment",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "run_gold_orchestrator",
				"type": "DatabricksNotebook",
				"dependsOn": [
					{
						"activity": "run_silver_orchestrator",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebookPath": "/Workspace/weather_notebook/nb_gold_orchestrator_dev",
					"baseParameters": {
						"environment": {
							"value": "@pipeline().parameters.environment",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "fail_transform",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "run_silver_orchestrator",
						"dependencyConditions": [
							"Failed"
						]
					},
					{
						"activity": "run_gold_orchestrator",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "@concat('Databricks transform failed at: ', utcNow())",
						"type": "Expression"
					},
					"errorCode": "500"
				}
			}
		],
		"parameters": {
			"environment": {
				"type": "string",
				"defaultValue": "dev"
			}
		},
		"annotations": []
	}
}